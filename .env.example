# ── Snowflake key-pair auth (same variable names as Adsight — copy your values) ──
# Provide EITHER the key contents inline OR a path to the .p8 file.
SNOWFLAKE_ACCOUNT=your_account_locator            # e.g. jacjgio-tf59088
SNOWFLAKE_USERNAME=your_service_user
SNOWFLAKE_ROLE=your_role                           # a role that can read SELLERS_DB.SELLERS
SNOWFLAKE_WAREHOUSE=your_warehouse                 # small XS warehouse recommended
SNOWFLAKE_DATABASE=SELLERS_DB
SNOWFLAKE_SCHEMA=SELLERS

# Option A — inline key contents (escape newlines as \n if pasting one line):
SNOWFLAKE_PRIVATE_KEY=

# Option B — path to the private key file (used only if SNOWFLAKE_PRIVATE_KEY is empty):
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8

# only if your key has a passphrase (Adsight's was blank):
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# local Express port (frontend proxy points here; 8788 avoids Adsight's 8787):
PORT=8788
